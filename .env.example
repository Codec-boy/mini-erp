# Mini ERP + CRM Operations Portal Environment Variables

# Node Environment & Port (Set automatically by Render)
PORT=10000
NODE_ENV=production

# PostgreSQL Database Connection String (Render Postgres or Supabase/Neon)
DATABASE_URL="postgresql://user:password@hostname:5432/dbname?sslmode=require"

# Security & Authentication
JWT_SECRET="your-strong-production-jwt-secret-key"
JWT_EXPIRES_IN="24h"

# Frontend / Allowed Origins (Optional if hosted together)
CLIENT_URL="https://your-app-name.onrender.com"
